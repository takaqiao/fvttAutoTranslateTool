{
    "openai_api_key": "",
    "openai_base_url": "https://api.openai.com/v1",
    "model": "gpt-4.1",
    "fallback_model": "gpt-4.1-mini",
    "max_retries": 2,
    "request_timeout_seconds": 90,
    "long_text_timeout_seconds": 180,
    "long_text_char_threshold": 8000,
    "target_rpm": 500,
    "max_workers": 8,
    "glossary_path": "glossary.json",
    "extra_glossary_path": "glossary_sog.json",
    "system_name": "Pathfinder 2e (Season of Ghosts / 肆季鬼志)",
    "system_prompt_override": "",
    "files": [
        "SoGMods/kobold-dm-sog-maps-supplemental.kobold-dm-sog-maps-supplemental.json",
        "SoGMods/pf2e-season-of-ghosts-map-remake.season-of-ghosts-map-remake.json",
        "SoGMods/pf2e-season-of-ghosts-tools.season-of-ghosts-effects.json",
        "SoGMods/pf2e-season-of-ghosts-tools.season-of-ghosts-macros.json",
        "SoGMods/pf2e-season-of-ghosts-tools.season-of-ghosts-rolltables.json",
        "SoGMods/pf2e-season-of-ghosts-tools.season-of-ghosts-shop-actors.json",
        "SoGMods/pf2e-season-of-ghosts-tools.season-of-ghosts-shop-items.json",
        "SoGMods/season-of-ghosts-extra-maps.sog-extra-maps-import.json"
    ],
    "file_pairs": [],
    "batch_max_chars": 8000,
    "batch_max_fields": 40,
    "group_depth": 3,
    "skip_untranslated": true,
    "skip_markup_only": true,
    "skip_keys": ["command", "formula", "img", "src", "flags", "mapping"],
    "include_keys_only": [],
    "report_path": "sogmods_calibration_report.json",
    "dry_run_sample_batches": 3
}
