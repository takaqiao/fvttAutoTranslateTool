{{#if error}}
<h1 style="margin: 2em; text-align: center; margin-top: 20vh"><i class="fa-solid fa-message-exclamation fa-bounce" style="margin-right: 1em"></i>{{error}}</h1>
{{else}}
<div>
  <!-- used for noise background -->
  <canvas class="terminal-noise terminal-full"></canvas>

  {{#if backgroundVideo}}
  <video
    class="terminal-full"
    autoplay
    muted
    loop
    style="opacity: {{opacity}}; object-fit: cover; pointer-events: none; z-index: 1"
  >
    <source src="{{background}}" type="video/mp4" />
  </video>
  {{/if}}

  <div class="terminal-splash terminal-full" style="color: {{highlight}}; z-index: 1; background-position: center; background-size: cover; background-image: url('{{splashFile}}'); {{#if splashFile}}background: black{{/if}}">
    {{#if splashFile}}
    <video
      class="terminal-video-splash terminal-full"
      style="object-fit: cover; pointer-events: none"
      autoplay
      muted
      loop
    >
      <source src="{{splashFile}}" />
    </video>
    {{/if}}

    <div class="terminal-ascii terminal-z" style="display:{{#if showASCIILoading}}grid{{else}}none{{/if}}; font-weight: 1000">
      <pre>{{ascii}}</pre>
    </div>

    {{#if password}}
    <div class="terminal-password-container terminal-z" style="margin: auto; margin-top: 1em; text-align: center">
      <input class="terminal-password" style="color: {{highlight}}; border: 2px solid {{base}}" />
      <button type="button" data-action="password" style="margin: 1em auto 1em auto; width: 350px; height: 40px">Login</button
      <p>a password is required</p>
    </div>
    {{/if}}

    <div class="terminal-loading terminal-z" style="display:{{#if showASCIILoading}}block{{else}}none{{/if}}">
      <div class="terminal-bar" style="background-color: {{highlight}}"></div>
    </div>
  </div>

  {{#if effectNoise}} <div class="terminal-effects-noise"></div> {{/if}}
  {{#if effectScan}}  <div class="terminal-effects-scan"></div>  {{/if}}
  {{#if effectGlitch}}
  <svg viewBox="0 0 1 1" width='0' height='0' style="display: none">
    <filter id='noise' x='0%' y='0%' width='100%' height='100%'>
      <feTurbulence type="fractalNoise" baseFrequency="0 0" />
      <feDisplacementMap in="SourceGraphic" scale="35" />
    </filter>
  </svg>
  {{/if}}

  <!-- Keep terminal-main hidden initially via your CSS; when you show it, this stays positioned absolute -->
  <div class="terminal-main terminal-full" style="background-size: cover; background-position: center; {{#if background}} {{#unless backgroundVideo}}background-image: linear-gradient(rgba(0,0,0,0.9), rgba(0,0,0, {{backgroundOpacity}})), url('{{background}}'){{/unless}} {{/if}}">

    <!-- IMPORTANT: reserve footer space by insetting the container -->
    <div class="terminal-container terminal-full"
         style="position: absolute; top: 0; left: 0; right: 0; bottom: 36px; display: flex;">
      <div class="terminal-buttons" style="display: none">
        <p>FILE DIRECTORY</p>
        <div class="terminal-folders"></div>
      </div>

      <div class="terminal-content" style="width: 100%; height: 100%; {{#if shadowView}}cursor: not-allowed;{{/if}} ">
        <div class="terminal-title" style="display: none"></div>

        <div class="terminal-textbox" style="height: 97%; font-size: 1.2em; background-color: rgba(0,0,0,0.7); padding: 0;">
          <!-- === CLI AREA START === -->
          <div class="terminal-cli"
               data-username="{{username}}"
               data-host="{{host}}"
               style="
                 display: grid;
                 align-items: start;
                 grid-template-rows: min-content;  /* input row first, history second */
                 row-gap: 8px;
                 height: 100%;
                 padding: 10px;
                 color: {{highlight}};
                  font-family: monospace;
               ">
                 <!-- History FIRST (grows/scrolls) -->
                 <div class="terminal-history"
                      aria-live="polite"
                      aria-atomic="false"
                      style="
                        overflow-y: auto;
                        white-space: pre-wrap;
                        scrollbar-width: none;
                        -ms-overflow-style: none;
                        line-height: 1.4;
                        height: auto;          /* starts at 0 when empty */
                        min-height: 0;         /* allow scrolling within grid */
                        max-height: calc({{height}}px * 0.68);  /* cap at 68% of window height */
                      "></div>

                 <!-- Input SECOND (stays at bottom) -->
                 <div class="terminal-inputline" style="display: flex; align-items: center; gap: 6px;">
                   <pre class="terminal-prompt" style="margin: 0; display: inline-block; color: {{highlight}}">user@host: $ </pre>
                   <input class="terminal-input"
                          {{#if shadowView}}disabled{{/if}}
                          style="background: transparent; border: none; outline: none; flex: 1; color: {{highlight}}; padding: 0; position: relative; left: -4px"
                          type="text"
                          autocomplete="off"
                          spellcheck="false"
                          aria-label="Command input" />
                 </div>

          <!-- === CLI AREA END === -->
        </div>
      </div>
        <button {{#if shadowView}}disabled{{/if}} style="width: 100%; background: {{base}}; border: none; color: white; margin-top: 4px; outline: none;" data-action="help">HELP</button>
    </div>

    <!-- Footer pinned to bottom -->
    <!-- <div class="terminal-bottombar"
         style="
           position: absolute; left: 0; right: 0; bottom: 0; font-size: 1.3em; font-weight: 900;
           height: 36px; display: flex; align-items: center; justify-content: space-evenly;
           font-family: monospace; background: {{base}}; color: {{highlight}};
         ">
      <span>[1] help</span>
      <span>[2] minimize</span>
      <span>[3] save</span>
      <span>[4] exit</span>
    </div> -->
  </div>
</div>
{{/if}}
