              "text": "<h2 data-no-toc data-split-here=\"New Feats\">新专长</h2>\n<section class=\"action\">\n  <h2 class=\"split no-toc\"><span>@UUID[Compendium.pf2e.feats-srd.Item.MSyU208twPGKU16W]{冷静专注}</span><span>专长 8</span></h2>\n  <ul class=\"traits\">\n    <li class=\"trait uncommon\">罕见</li>\n\n    <li class=\"trait\">通用</li>\n\n    <li class=\"trait\">技能</li>\n  </ul>\n</section>\n\n<section class=\"action\">\n  <h2 class=\"split no-toc\">\n    <span>@UUID[Compendium.pf2e.feats-srd.Item.MMaUL7r99DY7nvds]{宽慰气场} <span class=\"pf2-icon\">r</span></span><span>专长 10</span>\n  </h2>\n  <ul class=\"traits\">\n    <li class=\"trait uncommon\">罕见</li>\n\n    <li class=\"trait\">专注</li>\n\n    <li class=\"trait\">情绪</li>\n\n    <li class=\"trait\">通用</li>\n\n    <li class=\"trait\">心灵</li>\n\n    <li class=\"trait\">技能</li>\n  </ul>\n</section>\n<section class=\"action\">\n  <h2 class=\"split no-toc\">\n    <span>@UUID[Compendium.pf2e.feats-srd.Item.u96anl3ACNhBqnbT]{融入人流} <span class=\"pf2-icon\">r</span></span><span>专长 7</span>\n  </h2>\n  <ul class=\"traits\">\n    <li class=\"trait uncommon\">罕见</li>\n\n    <li class=\"trait\">通用</li>\n\n    <li class=\"trait\">秘密</li>\n\n    <li class=\"trait\">技能</li>\n  </ul>\n</section>\n<h2 data-no-toc data-split-here=\"New Feats\">New Feats</h2>\n<section class=\"action\">\n  <h2 class=\"split no-toc\"><span>@UUID[Compendium.pf2e.feats-srd.Item.MSyU208twPGKU16W]{Calm and Centered}</span><span>Feat 8</span></h2>\n  <ul class=\"traits\">\n    <li class=\"trait uncommon\">Uncommon</li>\n\n    <li class=\"trait\">General</li>\n\n    <li class=\"trait\">Skill</li>\n  </ul>\n</section>\n\n<section class=\"action\">\n  <h2 class=\"split no-toc\">\n    <span>@UUID[Compendium.pf2e.feats-srd.Item.MMaUL7r99DY7nvds]{Comforting Presence} <span class=\"pf2-icon\">r</span></span><span>Feat 10</span>\n  </h2>\n  <ul class=\"traits\">\n    <li class=\"trait uncommon\">Uncommon</li>\n\n    <li class=\"trait\">Concentrate</li>\n\n    <li class=