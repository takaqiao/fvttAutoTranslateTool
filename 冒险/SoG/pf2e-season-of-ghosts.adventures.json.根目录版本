li>\n    <li class=\"trait\">Magical</li>\n    <li class=\"trait\">Mental</li>\n    <li class=\"trait\">Oil</li>\n  </ul>\n</section>\n<br />\n<section class=\"action\">\n  <h2 class=\"no-toc split\"><span class=\"keepme\">@UUID[Compendium.pf2e.equipment-srd.Item.vmsKlURWyWTGoO6o]{Sanctified Beans}</span> <span class=\"keepme\">Item 11</span></h2>\n  <ul class=\"traits\">\n    <li class=\"trait uncommon\">Uncommon</li>\n    <li class=\"trait\">Consumable</li>\n    <li class=\"trait\">Divine</li>\n    <li class=\"trait\">Magical</li>\n    <li class=\"trait\">Vitality</li>\n  </ul>\n</section>\n<br />\n<section class=\"action\">\n  <h2 class=\"no-toc split\"><span class=\"keepme\">@UUID[Compendium.pf2e.equipment-srd.Item.x6V1tlDDBTVj5XnW]{Spirit Trap}</span> <span class=\"keepme\">Item 2</span></h2>\n  <ul class=\"traits\">\n    <li class=\"trait uncommon\">Uncommon</li>\n    <li class=\"trait\">Consumable</li>\n    <li class=\"trait\">Magical</li>\n    <li class=\"trait\">Snare</li>\n    <li class=\"trait\">Trap</li>\n  </ul>\n</section>\n<br />\n<img src=\"modules/pf2e-season-of-ghosts/assets/art/pzo90199-thousand-yeardragonroot.webp\" data-tooltip=\"Thousand-Year Dragonroot\" class=\"float-right\" style=\"shape-outside:url('modules/pf2e-season-of-ghosts/assets/art/pzo90199-thousand-yeardragonroot.webp');width:40%;margin-right:-3em;clear:both\" />\n<section class=\"action\">\n  <h2 class=\"no-toc split\"><span class=\"keepme\">@UUID[Compendium.pf2e.equipment-srd.Item.pKQwOJsBAcNcXwe6]{Taljjae Tassel}</span> <span class=\"keepme\">Item 10</span></h2>\n  <ul class=\"traits\">\n    <li class=\"trait uncommon\">Uncommon</li>\n    <li class=\"trait\">Consumable</li>\n    <li class=\"trait\">Magical</li>\n    <li class=\"trait\">Talisman</li>\n  </ul>\n</section>\n<br />\n<section class=\"action\">\n  <h2 class=\"no-toc split\"><span class=\"keepme\">@UUID[Compendium.pf2e.equipment-srd.Item.xVK6dbAIUJqNFYoI]{Thousand-Year Dragonroot}</span> <span class=\"keepme\">Item 10<