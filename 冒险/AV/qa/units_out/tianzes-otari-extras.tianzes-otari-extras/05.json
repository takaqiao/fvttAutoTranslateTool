    "entries",
    "Tianze's Otari Extras",
    "actors",
    "Crook's Nook",
    "items",
    "Drink - Mug of Beer",
    "description"
   ],
   "zh": "<p>一种拉格啤酒，有淡色也有深色，比麦芽酒更贵。</p>"
